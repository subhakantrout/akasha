# Akasha Configuration
NODE_ENV=development
PORT=8080

# Ollama Integration
OLLAMA_HOST=http://localhost:11434

# Python Ingestion Engine
PYTHON_ENGINE_HOST=http://127.0.0.1
PYTHON_ENGINE_PORT=8000

# Security
CORS_ORIGIN=*
ENABLE_AUTH=false
API_KEY=your-secret-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Data Paths
DATA_DIR=./data
VAULT_DIR=./data/vault
CHROMA_DB_PATH=./data/chroma_db

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/akasha.log

# Features
ENABLE_WEB_SCRAPING=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_HARVESTER=true

# Harvester Settings
HARVESTER_RATE_LIMIT_MS=2000
HARVESTER_MAX_RETRIES=3
HARVESTER_RETRY_BACKOFF_MS=5000
